# ==============================================================================
# .gitignore - Classificador de Sorotipos do Vírus da Dengue (PMC)
# ==============================================================================

# Byte-compiled / otimizados / cache Python e Testes
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Cache local do Streamlit
.streamlit/

# Ambientes Virtuais (Virtual Environments)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Arquivos de IDEs e Editores de Código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs e Processos em Background
*.log
*.pid

# Relatórios temporários e dinâmicos de predição gerados pela CLI
predicoes_*.csv
resultados/predicoes/predicoes_*.csv

# (Opcional) Descomente as linhas abaixo caso não deseje versionar 
# os modelos treinados pesados ou arquivos de dados brutos muito volumosos:
# *.joblib
# *.fasta

